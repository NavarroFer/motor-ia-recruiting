# Con DATABASE_URL usa el Postgres de docker-compose. Sin ella, usa PGlite embebido en ./.data
DATABASE_URL=postgres://motor:motor@localhost:5433/motor

# Firmar la cookie de sesión (cualquier string largo)
SESSION_SECRET=cambiar-por-un-string-largo-y-aleatorio

# APIs. La app arranca con la API desactivada: se activa desde Admin > Consumo.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Modelos (precios en src/lib/pricing.ts)
ANTHROPIC_MODEL=claude-haiku-5-5
EMBEDDING_MODEL=text-embedding-3-small
